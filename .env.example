# 3D Portfolio Environment Configuration
# If unset, defaults to local /models/after_the_rain_2k.glb in development,
# and GitHub Release CDN URL in production.
VITE_RAIN_STREET_MODEL_URL=

# MongoDB & Admin Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio_db?retryWrites=true&w=majority
ADMIN_PASSWORD=your_admin_secret_password
