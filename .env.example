# ============================================================================
# 3D + 2D Hybrid Portfolio Engine — Environment Configuration
# Copy this file to `.env.local` for local development (`cp .env.example .env.local`)
# On Vercel, add these variables under Project Settings -> Environment Variables.
# Full step-by-step guide: see GUIDELINE.md
# ============================================================================

# [Optional] Custom CDN / GitHub Release base URL for 3D .glb models.
# Leave empty to serve models from local `public/models/` (populated via `npm run download-models`).
# Example: VITE_MODEL_BASE_URL=https://github.com/mdkaiumhasan/portfolio-3D/releases/download/1.0.0
VITE_MODEL_BASE_URL=

# [Required for Dynamic Data & Direct Inbox] MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio_db?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio_db

# [Required for /admin Console] Administrator Login & HMAC-SHA256 Session Signing
ADMIN_PASSWORD=change_this_to_a_strong_password
JWT_SECRET=generate_a_random_64_char_hex_secret_here

# [Required for Image Uploads in /admin] Cloudinary Media Hosting
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# [Optional] Google Gemini API Key (Enables 1-click AI Blog Generation inside /admin)
GEMINI_API_KEY=your_google_gemini_api_key
